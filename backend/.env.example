PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shootatsightweddings
NODE_ENV=development

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Cloudflare Stream (keep this API token on the backend only; never VITE_*)
# Create a token with the Stream > Edit permission for this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Generate a unique random secret before starting the backend.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Required only to bootstrap the initial admin; no default credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
